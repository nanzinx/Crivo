# ===== Argus (discadora) - doc-api-argus.pdf =====
ARGUS_BASE_URL=https://argus.app.br/apiargus
# Enviado no header "Token-Signature" (Configurações > Desenvolvedor > Acesso API)
ARGUS_TOKEN=seu_token_argus
# IDs de campanha monitoradas (polling/backfill via /report/ligacoesdetalhadas)
ARGUS_CAMPAIGN_IDS=
ARGUS_AUDIO_FORMAT=MP3
ARGUS_AUDIO_CHANNELS=1
# Segredo opcional validado no header X-Webhook-Secret (ou ?secret=) do webhook
ARGUS_WEBHOOK_SECRET=

# ===== IA (OpenAI / ChatGPT). Sem chave => audios sem transcricao ficam "awaiting_ai" =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

# ===== Banco (SQLite por padrao; PostgreSQL: postgresql+psycopg://user:pass@host/db) =====
DATABASE_URL=sqlite:///./supervisor.db

# ===== Pastas locais =====
RECORDINGS_DIR=c:/Projetos/testes/Gravações
LEGACY_CSV=c:/Projetos/testes/relatorio_escuta_gravacoes.csv
ARGUS_DOWNLOAD_DIR=./data/argus
