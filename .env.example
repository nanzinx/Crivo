# ============================================================
#  Crivo — copie para .env (na raiz do repositório) e preencha
# ============================================================

# ----- Argus (discadora) -----
ARGUS_BASE_URL=https://argus.app.br/apiargus
# Header "Token-Signature" (Argus > Configurações > Desenvolvedor > Acesso API)
ARGUS_TOKEN=
# Campanhas monitoradas pelo polling/backfill, separadas por vírgula (ex.: 12,15)
ARGUS_CAMPAIGN_IDS=
ARGUS_POLL_MINUTOS=5
ARGUS_AUDIO_FORMAT=MP3
# 1 = mono | 2 = estéreo | 3 = estéreo separando as pontas A/B
ARGUS_AUDIO_CHANNELS=1
# Segredo do webhook (header X-Webhook-Secret ou ?secret=)
ARGUS_WEBHOOK_SECRET=

# ----- IA (OpenAI). Sem chave => áudios sem transcrição ficam "aguardando IA" -----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Transcrição: gpt-4o-mini-transcribe custa cerca de metade do whisper-1.
# Antes de confiar na troca, rode: python -m scripts.comparar_transcricao
OPENAI_WHISPER_MODEL=gpt-4o-mini-transcribe

# ----- Custo de IA -----
# true = a IA também reescreve a conversa separada por falante (resposta ~5x maior, mais cara)
IA_DIARIZAR=false
# Teto de gasto por dia em US$ (0 = sem teto). Ao atingir, as ligações esperam até o dia seguinte.
IA_TETO_DIARIO_USD=0
# Preços em US$ para o cálculo do custo. 0 = tabela embutida (app/services/custos.py)
PRECO_TRANSCRICAO_MINUTO=0
PRECO_ENTRADA_1M=0
PRECO_SAIDA_1M=0

# ----- Detecção local de fala (gratuita) -----
# Ligação sem nenhuma fala vira "Mudo total" sem chamar a IA. Valide com: python -m scripts.validar_vad
VAD_ATIVO=true
VAD_FALA_MINIMA_SEGUNDOS=0.6
# "Tabulou muda/caixa postal, mas tem conversa": quanto de fala dispara o aviso de revisão
SUSPEITA_FALA_CANAL_SEGUNDOS=3
SUSPEITA_FALA_MONO_SEGUNDOS=20

# Abaixo desta confiança a IA não aponta divergência: a ligação vai para revisão humana
CONFIANCA_MINIMA_DIVERGENCIA=0.6

# ----- Banco (SQLite por padrão; PostgreSQL: postgresql+psycopg://user:pass@host/db) -----
DATABASE_URL=sqlite:///./data/crivo.db

# ----- API -----
# Origens liberadas no CORS (o frontend em dev usa proxy, então normalmente não precisa mudar)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----- Arquivos locais (caminhos relativos à raiz do repositório ou absolutos) -----
RECORDINGS_DIR=./data/gravacoes
LEGACY_CSV=./data/relatorio_escuta_gravacoes.csv
LEGACY_HTML=./data/dashboard_gravacoes.html
CRUZAR_CSV=./data/cruzar_dados.csv
ARGUS_DOWNLOAD_DIR=./data/argus

# ----- Painel de saúde -----
ALERTA_WEBHOOK_MINUTOS=30
HORARIO_COMERCIAL=8-20
ALERTA_FILA_MAX=200
