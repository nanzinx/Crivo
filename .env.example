# ============================================================
#  Crivo — copie para .env (na raiz do repositório) e preencha
# ============================================================

# ----- Argus (discadora) -----
ARGUS_BASE_URL=https://argus.app.br/apiargus
# Header "Token-Signature" (Argus > Configurações > Desenvolvedor > Acesso API)
ARGUS_TOKEN=
# Campanhas monitoradas pelo polling/backfill, separadas por vírgula (ex.: 12,15)
ARGUS_CAMPAIGN_IDS=
ARGUS_POLL_MINUTOS=5
ARGUS_AUDIO_FORMAT=MP3
# 1 = mono | 2 = estéreo | 3 = estéreo separando as pontas A/B
ARGUS_AUDIO_CHANNELS=1
# Segredo do webhook (header X-Webhook-Secret ou ?secret=)
ARGUS_WEBHOOK_SECRET=
# Com o token: operadores/equipes e ponto (entrada/saída e pausas) chegam sozinhos pela API, a cada N minutos
ARGUS_PONTO_AUTOMATICO=true
ARGUS_PONTO_MINUTOS=30

# ----- Acesso -----
# Login no painel e na API. false SÓ para desenvolvimento local (todos entram como administrador)
AUTH_ATIVO=true
SESSAO_HORAS=12
# true quando o painel estiver atrás de HTTPS
COOKIE_SEGURO=false
# Senha do PostgreSQL usado pelo docker compose
POSTGRES_PASSWORD=troque-esta-senha

# ----- Banco (SQLite por padrão; PostgreSQL: postgresql+psycopg://user:pass@host/db) -----
DATABASE_URL=sqlite:///./data/crivo.db

# ----- API -----
# Origens liberadas no CORS (o frontend em dev usa proxy, então normalmente não precisa mudar)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----- Arquivos locais (caminhos relativos à raiz do repositório ou absolutos) -----
RECORDINGS_DIR=./data/gravacoes
# Máximo de gravações num .zip exportado (Ligações → Baixar gravações)
ZIP_MAX_GRAVACOES=1000
LEGACY_CSV=./data/relatorio_escuta_gravacoes.csv
LEGACY_HTML=./data/dashboard_gravacoes.html
CRUZAR_CSV=./data/cruzar_dados.csv
ARGUS_DOWNLOAD_DIR=./data/argus

# ----- Painel de saúde -----
ALERTA_WEBHOOK_MINUTOS=30
HORARIO_COMERCIAL=8-20
ALERTA_FILA_MAX=200

# ----- Alertas automáticos -----
ALERTA_INTERVALO_MINUTOS=15
ALERTA_OPERADOR_HORAS=24
ALERTA_OPERADOR_MIN_LIGACOES=20
ALERTA_OPERADOR_TAXA=20
ALERTA_OPERADOR_ALTAS=5
ALERTA_TRONCO_HORAS=3
ALERTA_TRONCO_MIN_LIGACOES=20
ALERTA_TRONCO_MUDAS_PCT=40
ALERTA_RENOTIFICAR_HORAS=6

# ----- Relatório diário -----
RELATORIO_HORA=19
# Dias da semana: 0 = segunda ... 6 = domingo
RELATORIO_DIAS=0-5

# ----- Notificações (sem nada configurado, alertas e relatórios ficam só no painel) -----
# Webhook de entrada do Slack, Microsoft Teams ou Google Chat
NOTIFICAR_WEBHOOK_URL=
# E-mail
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_TLS=true
SMTP_REMETENTE=
# Destinatários, separados por vírgula
NOTIFICAR_EMAILS=
# Endereço do painel, para os links nas mensagens
PAINEL_URL=

# Domínio público para o HTTPS automático (docker compose --profile https). Preenchido por scripts/preparar_servidor.sh
CRIVO_DOMINIO=
