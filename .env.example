# ============================================================
#  Crivo — copie para .env (na raiz do repositório) e preencha
# ============================================================

# ----- Argus (discadora) -----
ARGUS_BASE_URL=https://argus.app.br/apiargus
# Header "Token-Signature" (Argus > Configurações > Desenvolvedor > Acesso API)
ARGUS_TOKEN=
# Campanhas monitoradas pelo polling/backfill, separadas por vírgula (ex.: 12,15)
ARGUS_CAMPAIGN_IDS=
ARGUS_POLL_MINUTOS=5
ARGUS_AUDIO_FORMAT=MP3
# 1 = mono | 2 = estéreo | 3 = estéreo separando as pontas A/B
ARGUS_AUDIO_CHANNELS=1
# Segredo do webhook (header X-Webhook-Secret ou ?secret=)
ARGUS_WEBHOOK_SECRET=

# ----- IA (OpenAI). Sem chave => áudios sem transcrição ficam "aguardando IA" -----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

# ----- Banco (SQLite por padrão; PostgreSQL: postgresql+psycopg://user:pass@host/db) -----
DATABASE_URL=sqlite:///./data/crivo.db

# ----- API -----
# Origens liberadas no CORS (o frontend em dev usa proxy, então normalmente não precisa mudar)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----- Arquivos locais (caminhos relativos à raiz do repositório ou absolutos) -----
RECORDINGS_DIR=./data/gravacoes
LEGACY_CSV=./data/relatorio_escuta_gravacoes.csv
LEGACY_HTML=./data/dashboard_gravacoes.html
CRUZAR_CSV=./data/cruzar_dados.csv
ARGUS_DOWNLOAD_DIR=./data/argus

# ----- Painel de saúde -----
ALERTA_WEBHOOK_MINUTOS=30
HORARIO_COMERCIAL=8-20
ALERTA_FILA_MAX=200
